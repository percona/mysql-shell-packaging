commit fa46085c15583fe66a3875f8d49fc7bb0f288bad
Author: Paweł Andruszkiewicz <pawel.andruszkiewicz@oracle.com>
Date:   Thu Jul 2 20:52:15 2026 +0200

    Fix bundled shared library handling on ELF
    
    Shell consumes bundled protobuf from the server build, but the final
    ELF links did not list the Abseil hash library that protobuf needs.
    GNU ld can fail to resolve protobuf's Abseil hash symbols when the gold
    linker is not available.
    
    Add the bundled Abseil hash library to the protobuf link interface, and
    link run_unit_tests through PROTOBUF_LIBRARIES so tests receive the same
    protobuf companion libraries as Shell binaries.
    
    Ubuntu package builds also run dh_strip, which invokes debugedit before
    objcopy. debugedit corrupts some DSOs after Shell writes an RPATH into
    them. On Ubuntu builds using system OpenSSL, avoid adding an RPATH to
    libfido2 itself and to authentication plugins that only use system
    shared libraries. Keep the WebAuthn plugin RPATH so it can locate the
    bundled libfido2 dependency.
    
    Builds with bundled OpenSSL keep the RPATH on these libraries so they
    can find the bundled crypto libraries.
    
    Change-Id: I9d91cd71c9a4b2648248523846b453706999f977
    (cherry picked from commit a8cf96b44f21dba9dc2c0de2b66e48043a143279)

diff --git a/cmake/protobuf.cmake b/cmake/protobuf.cmake
index e408bac0d..b9e19851f 100644
--- a/cmake/protobuf.cmake
+++ b/cmake/protobuf.cmake
@@ -112,6 +112,14 @@ IF(NOT WITH_PROTOBUF)
   ELSE()
     FILE(GLOB BUNDLED_ABSEIL_LIBRARIES LIST_DIRECTORIES false "${_protobuf_lib_dir}/libabsl_*.so")
 
+    IF(NOT APPLE)
+      FOREACH(_lib ${BUNDLED_ABSEIL_LIBRARIES})
+        IF(_lib MATCHES "libabsl_hash\\.so$")
+          list(APPEND PROTOBUF_LIBRARIES "${_lib}")
+        ENDIF()
+      ENDFOREACH()
+    ENDIF()
+
     IF(CMAKE_BUILD_TYPE STREQUAL "Debug")
       # we need to explicitly link with log libraries and their dependencies
       FOREACH(_lib ${BUNDLED_ABSEIL_LIBRARIES})
diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 046211174..f90c529a8 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -436,20 +436,59 @@ ENDIF()
 # If defined, installs the client authentication plugins
 IF(AUTH_CLIENT_PLUGINS)
   IF(AUTH_CLIENT_PLUGINS_DEPS)
+    SET(AUTH_CLIENT_PLUGINS_DEPS_OPTIONS)
+    IF(LINUX_UBUNTU AND NOT BUNDLED_OPENSSL)
+      # Do not add an RPATH to libfido2 itself; debugedit corrupts this
+      # patched DSO in dh_strip on Ubuntu builds using the system OpenSSL
+      # libraries.
+      LIST(APPEND AUTH_CLIENT_PLUGINS_DEPS_OPTIONS WRITE_RPATH FALSE)
+    ENDIF()
+
     install_bundled_binaries(
         DESCRIPTION "MySQL authentication plugins - dependencies"
         BINARIES ${AUTH_CLIENT_PLUGINS_DEPS}
         DESTINATION "${INSTALL_LIBDIR}"
         TARGET mysqlsh
+        ${AUTH_CLIENT_PLUGINS_DEPS_OPTIONS}
     )
   ENDIF()
 
-  install_bundled_binaries(
-      DESCRIPTION "MySQL authentication plugins"
-      BINARIES ${AUTH_CLIENT_PLUGINS}
-      DESTINATION "${INSTALL_MYSQL_PLUGINS_DIR}"
-      TARGET mysqlsh
-  )
+  SET(AUTH_CLIENT_PLUGINS_WITH_RPATH ${AUTH_CLIENT_PLUGINS})
+  SET(AUTH_CLIENT_PLUGINS_WITHOUT_RPATH)
+
+  IF(LINUX_UBUNTU AND NOT BUNDLED_OPENSSL)
+    SET(AUTH_CLIENT_PLUGINS_WITH_RPATH)
+
+    # The WebAuthn plugin needs the RPATH to find libfido2. Other
+    # authentication plugins in Ubuntu system-OpenSSL packages use only
+    # system shared libraries; avoid patching them before dh_strip.
+    FOREACH(_plugin ${AUTH_CLIENT_PLUGINS})
+      IF(_plugin MATCHES "authentication_webauthn_client\\.")
+        LIST(APPEND AUTH_CLIENT_PLUGINS_WITH_RPATH "${_plugin}")
+      ELSE()
+        LIST(APPEND AUTH_CLIENT_PLUGINS_WITHOUT_RPATH "${_plugin}")
+      ENDIF()
+    ENDFOREACH()
+  ENDIF()
+
+  IF(AUTH_CLIENT_PLUGINS_WITHOUT_RPATH)
+    install_bundled_binaries(
+        DESCRIPTION "MySQL authentication plugins without RPATH"
+        BINARIES ${AUTH_CLIENT_PLUGINS_WITHOUT_RPATH}
+        DESTINATION "${INSTALL_MYSQL_PLUGINS_DIR}"
+        TARGET mysqlsh
+        WRITE_RPATH FALSE
+    )
+  ENDIF()
+
+  IF(AUTH_CLIENT_PLUGINS_WITH_RPATH)
+    install_bundled_binaries(
+        DESCRIPTION "MySQL authentication plugins"
+        BINARIES ${AUTH_CLIENT_PLUGINS_WITH_RPATH}
+        DESTINATION "${INSTALL_MYSQL_PLUGINS_DIR}"
+        TARGET mysqlsh
+    )
+  ENDIF()
 ELSE()
   MESSAGE(WARNING "Could not find Authentication Client Plugins!")
 ENDIF()
